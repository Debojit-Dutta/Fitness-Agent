# ============================================================
#  Fitness Buddy — Environment Configuration TEMPLATE
#  Copy this file to .env and fill in your real credentials
#  IBM Cloud watsonx.ai (IBM Granite) — MANDATORY SERVICE
# ============================================================

# ------ IBM watsonx.ai (IBM Granite LLM) --------------------
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# watsonx.ai service URL (choose region-specific endpoint)
# Dallas  : https://us-south.ml.cloud.ibm.com
# London  : https://eu-gb.ml.cloud.ibm.com
# Frankfurt: https://eu-de.ml.cloud.ibm.com
# Tokyo   : https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Cloud project ID (from watsonx.ai project settings)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM Granite model to use (IBM Cloud Lite tier — free)
# Options: ibm/granite-3-8b-instruct | ibm/granite-13b-instruct-v2
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ------ IBM Watson Assistant (optional chatbot fallback) -----
# Obtain from: https://cloud.ibm.com/catalog/services/watson-assistant
WATSON_ASSISTANT_API_KEY=your_watson_assistant_api_key_here
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com
WATSON_ASSISTANT_ID=your_assistant_instance_id_here

# ------ Application Settings --------------------------------
PORT=3000
NODE_ENV=development

# Session secret for express-session (change in production)
SESSION_SECRET=fitness_buddy_secret_2024_ibm_granite
